<% var s = stats || { total: 0, online: 0, offline: 0, unknown: 0 }; %>

<!-- Stats Cards -->
<div class="row">
  <div class="col-lg-3 col-md-6 col-sm-6 col-12">
    <div class="stat-card stat-card-bg-primary">
      <div class="stat-icon"><i class="fas fa-server"></i></div>
      <div class="stat-label">Total Perangkat</div>
      <div class="stat-value" data-stat="total"><%= s.total %></div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6 col-sm-6 col-12">
    <div class="stat-card stat-card-bg-success">
      <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
      <div class="stat-label">Online</div>
      <div class="stat-value" data-stat="online"><%= s.online %></div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6 col-sm-6 col-12">
    <div class="stat-card stat-card-bg-danger">
      <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
      <div class="stat-label">Offline</div>
      <div class="stat-value" data-stat="offline"><%= s.offline %></div>
    </div>
  </div>
  <div class="col-lg-3 col-md-6 col-sm-6 col-12">
    <div class="stat-card stat-card-bg-warning">
      <div class="stat-icon"><i class="fas fa-question-circle"></i></div>
      <div class="stat-label">Unknown</div>
      <div class="stat-value" data-stat="unknown"><%= s.unknown %></div>
    </div>
  </div>
</div>

<!-- Filter & Actions -->
<div class="card">
  <div class="card-header">
    <h4><i class="fas fa-list me-2"></i>Daftar Perangkat</h4>
    <div class="card-header-action">
      <% if (user && user.role === 'admin') { %>
      <a href="/devices/new" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i> Tambah
      </a>
      <% } %>
    </div>
  </div>
  <div class="card-body">
    <form id="filters" class="filter-bar mb-3">
      <div class="input-group" style="max-width: 250px;">
        <span class="input-group-text"><i class="fas fa-search"></i></span>
        <input type="search" class="form-control" name="q" placeholder="Cari perangkat..." value="<%= (filters && filters.q) || '' %>">
      </div>
      <select name="status" class="form-select">
        <option value="">Semua Status</option>
        <option value="online" <%= (filters && filters.status === 'online') ? 'selected' : '' %>>Online</option>
        <option value="offline" <%= (filters && filters.status === 'offline') ? 'selected' : '' %>>Offline</option>
        <option value="unknown" <%= (filters && filters.status === 'unknown') ? 'selected' : '' %>>Unknown</option>
      </select>
      <select name="group" class="form-select">
        <option value="">Semua Grup</option>
        <% (groups || []).forEach(function(g) { %>
        <option value="<%= g %>" <%= (filters && filters.group === g) ? 'selected' : '' %>><%= g %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i> Filter</button>
    </form>

    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Status</th>
            <th>Nama</th>
            <th>Alamat</th>
            <th>Grup</th>
            <th>Terakhir Online</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody id="device-rows">
          <%- include('../partials/device-rows', { items: items, user: user }) %>
        </tbody>
      </table>
    </div>

    <% if (!items || items.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-server"></i>
      <h4>Belum ada perangkat</h4>
      <p class="text-muted">Tambahkan perangkat pertama Anda untuk mulai memantau.</p>
      <% if (user && user.role === 'admin') { %>
      <a href="/devices/new" class="btn btn-primary mt-3">
        <i class="fas fa-plus me-1"></i> Tambah Perangkat
      </a>
      <% } %>
    </div>
    <% } %>
  </div>
</div>