<div class="card">
  <div class="card-header">
    <h4><i class="fas fa-exclamation-triangle me-2"></i><%= code %> - <%= message %></h4>
  </div>
  <div class="card-body text-center py-5">
    <div style="font-size: 6rem; color: #6777ef; opacity: 0.3;">
      <i class="fas fa-<%= code === 404 ? 'question-circle' : code === 403 ? 'lock' : 'bug' %>"></i>
    </div>
    <h3 class="mt-3"><%= code === 404 ? 'Halaman Tidak Ditemukan' : code === 403 ? 'Akses Ditolak' : 'Terjadi Kesalahan' %></h3>
    <p class="text-muted mb-4"><%= message %></p>
    <a href="/" class="btn btn-primary">
      <i class="fas fa-home me-1"></i> Kembali ke Dashboard
    </a>
  </div>
</div>