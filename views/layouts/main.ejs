<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? title + ' · ' : '' %><%= appName %></title>

  <!-- Stisla / Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 (used by Stisla) -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
  <!-- Stisla Core CSS -->
  <link href="https://cdn.jsdelivr.net/npm/stisla@3.0.0/dist/css/stisla.min.css" rel="stylesheet">
  <!-- Meridian Theme (dark) -->
  <link href="https://cdn.jsdelivr.net/npm/stisla@3.0.0/dist/css/meridian.min.css" rel="stylesheet">
  <!-- App custom CSS -->
  <link href="/dist/app.css" rel="stylesheet">

  <meta name="csrf-token" content="<%= csrf %>">
  <script src="/js/theme.js"></script>
</head>
<body class="layout-3">
  <div id="app">
    <!-- Top Navbar -->
    <div class="main-header navbar navbar-expand navbar-dark">
      <div class="navbar-header">
        <a href="/" class="navbar-brand">
          <i class="fas fa-network-wired me-2"></i><%= appName %>
        </a>
      </div>
      <div class="navbar-collapse collapse">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a href="/" class="nav-link <%= nav === 'dashboard' ? 'active' : '' %>">
              <i class="fas fa-th-large"></i> <span>Dashboard</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/devices" class="nav-link <%= nav === 'devices' ? 'active' : '' %>">
              <i class="fas fa-server"></i> <span>Perangkat</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/groups" class="nav-link <%= nav === 'groups' ? 'active' : '' %>">
              <i class="fas fa-layer-group"></i> <span>Grup</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/audit" class="nav-link <%= nav === 'audit' ? 'active' : '' %>">
              <i class="fas fa-history"></i> <span>Audit</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="/settings" class="nav-link <%= nav === 'settings' ? 'active' : '' %>">
              <i class="fas fa-cog"></i> <span>Pengaturan</span>
            </a>
          </li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <!-- Theme Toggle -->
          <li class="nav-item">
            <button id="theme-toggle" class="nav-link btn btn-link" aria-label="Ganti tema">
              <i class="fas fa-moon"></i>
            </button>
          </li>
          <!-- User Dropdown -->
          <% if (user) { %>
          <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" id="user-menu-btn" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-user-circle me-1"></i> <%= user.username %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" id="user-menu" aria-labelledby="user-menu-btn">
              <li><span class="dropdown-item-text text-muted small"><%= user.role === 'admin' ? 'Administrator' : 'User' %></span></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/auth/logout" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button type="submit" class="dropdown-item">
                    <i class="fas fa-sign-out-alt me-2"></i> Keluar
                  </button>
                </form>
              </li>
            </ul>
          </li>
          <% } %>
        </ul>
      </div>
    </div>

    <!-- Main Content -->
    <div class="main-wrapper">
      <div class="main-content">
        <section class="section">
          <% if (title) { %>
          <div class="section-header">
            <h1><%= title %></h1>
            <div class="section-header-breadcrumb">
              <div class="breadcrumb-item"><a href="/"><%= appName %></a></div>
              <% if (nav) { %>
              <div class="breadcrumb-item active"><%= title %></div>
              <% } %>
            </div>
          </div>
          <% } %>
          <div class="section-body">
            <!-- Flash messages -->
            <% if (flash) { %>
            <div class="alert alert-<%= flash.type || 'info' %> alert-dismissible fade show">
              <%= flash.message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>
            <%- body %>
          </div>
        </section>
      </div>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="footer-left">
        <%= appName %> &copy; 2024 · Device monitor &amp; remote access
      </div>
      <div class="footer-right">
        <span id="last-refresh"></span>
      </div>
    </footer>
  </div>

  <!-- Toast notification -->
  <div id="toast" class="toast-notification hidden"></div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
</body>
</html>